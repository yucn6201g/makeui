# Build settings for the Playwright E2E tests (vite build --mode e2e). Committed on purpose:
# none of these is real. Both hosts are unresolvable, so a request the tests forgot to mock
# fails instead of reaching a real API or user pool — and the test that made it fails too.
VITE_API_URL=http://api.e2e.test
# The part before `_` is the region, which names the Cognito host: cognito-idp.e2e-test-1.amazonaws.com.
VITE_COGNITO_USER_POOL_ID=e2e-test-1_E2ETEST00
VITE_COGNITO_CLIENT_ID=e2etestclient000000000000
