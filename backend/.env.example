AWS_REGION=ap-northeast-1
PORT=8080
ALLOWED_ORIGIN=http://localhost:5173

# Cognito
COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# DynamoDB
USAGE_TABLE_NAME=makeui-token-usage

# AWS Account (used for default S3 bucket name construction)
AWS_ACCOUNT_ID=123456789012

# S3
OUTPUT_BUCKET_NAME=makeui-outputs-<your-account-id>
KB_BUCKET_NAME=makeui-knowledge-base-<your-account-id>

# Token limits (default for users without individual config)
MONTHLY_TOKEN_LIMIT=1000000

# CloudFront domain for published pages
CLOUDFRONT_DOMAIN=dxxxxxxxxx.cloudfront.net

# Admin emails (comma-separated, these users can access /admin/* endpoints)
ADMIN_EMAILS=admin@example.com
